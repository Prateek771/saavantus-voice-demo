{
  "name": "saavantus-voice-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-sarvam-sdk.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "google:authorize": "node --env-file=.env scripts/authorize-discovery-google.mjs",
    "google:setup": "node --env-file=.env scripts/setup-discovery-google.mjs"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "google-auth-library": "^10.9.1",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sarvam-conv-ai-sdk": "0.0.42",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
