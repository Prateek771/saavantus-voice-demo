# Local preview. Managed Sarvam voice requires all fields below and explicit enablement.
APP_MODE=local-demo
NEXT_TELEMETRY_DISABLED=1
# Future server-only credentials. Leave blank for this preview.
SARVAM_API_KEY=
SARVAM_VOICE_ENABLED=false
SARVAM_AGENTS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_REAL_ESTATE_AGENT_ID=
SARVAM_REAL_ESTATE_VERSION=1
SARVAM_HEALTHCARE_AGENT_ID=
SARVAM_HEALTHCARE_VERSION=1
# Exact wss:// origin returned by an authenticated session-signing request.
SARVAM_WS_ORIGIN=
N8N_BASE_URL=
N8N_API_KEY=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
# Optional exact HTTPS origin for an explicitly shared temporary preview.
# Leave empty to keep voice/contact endpoints restricted to localhost.
SAAVANTUS_PREVIEW_ORIGIN=

# Owner-only Google OAuth setup. Never prefix credentials with NEXT_PUBLIC_.
# Place downloaded OAuth client JSON at the first path; authorize/setup generate the others.
DISCOVERY_GOOGLE_CLIENT_FILE=.data/google-oauth-client.json
DISCOVERY_GOOGLE_CREDENTIALS_FILE=.data/google-discovery-oauth.json
DISCOVERY_GOOGLE_CONFIG_FILE=.data/google-discovery-config.json
# Optional explicitly selected folder owned by mukesh.das@saavantus.com. Blank = My Drive.
DISCOVERY_GOOGLE_PARENT_FOLDER_ID=
